APP_NAME="OSPOS Next"
APP_ENV=local
# Generate your own with `php artisan key:generate` -- a real, populated key
# checked into a committed .env.example is trivially public, and a deploy
# that copies this file without regenerating it makes every signed URL,
# encrypted cookie and Crypt:: payload forgeable by anyone who can read the
# repo.
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=root
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# config/session.php's 'secure' has no default (null -> "secure iff this
# request looks like HTTPS"), so behind a TLS-terminating proxy with no
# trusted-proxy config the session cookie can ship without Secure even on
# an HTTPS-only site. Set explicitly for any non-local deploy.
# SESSION_SECURE_COOKIE=true

# Only relevant if SPA cookie-based auth is ever enabled (it isn't wired
# into the api middleware group today, see bootstrap/app.php) -- but the
# stock default here is localhost-only, so set this before it is.
# SANCTUM_STATEFUL_DOMAINS=your-domain.example

# Comma-separated list of origins allowed to call the API cross-origin.
# Left unset, config/cors.php falls back to '*' (fine for local dev, not
# for a real deploy).
# CORS_ALLOWED_ORIGINS=https://pos.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POS_CURRENCY="LKR"
POS_TIMEZONE="Asia/Colombo"
POS_CASH_ROUNDING=0
